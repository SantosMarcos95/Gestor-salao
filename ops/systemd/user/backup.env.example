# Copiar para .local/backup.env com modo 0600. Nunca enviar a chave ao Git.
BACKUP_DIRECTORY=/home/marcos_paulo/salao-gestao/.local/backups
BACKUP_REMOTE=drive_salao:backups
BACKUP_ENCRYPTION_KEY=SUBSTITUIR_POR_64_CARACTERES_HEXADECIMAIS
BACKUP_REQUIRE_OFFSITE=true
BACKUP_MAX_AGE_HOURS=26
RCLONE_BIN=/home/marcos_paulo/salao-gestao/.local/bin/rclone
RCLONE_CONFIG=/home/marcos_paulo/salao-gestao/.local/rclone.conf
POSTGRES_BIN=/home/marcos_paulo/salao-gestao/.local/pg-client/usr/lib/postgresql/17/bin
LD_LIBRARY_PATH=/home/marcos_paulo/salao-gestao/.local/pg-client/usr/lib/x86_64-linux-gnu
# BACKUP_ALERT_WEBHOOK_URL=https://SUBSTITUIR

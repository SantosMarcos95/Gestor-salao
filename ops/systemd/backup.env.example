# Modelo para /etc/salao-backup.env; arquivo real restrito ao administrador (0600).
# Substituir os campos no servidor. Não colocar credenciais reais no repositório.
BACKUP_DATABASE_URL=postgresql://SUBSTITUIR_USUARIO:SUBSTITUIR_SENHA@127.0.0.1:5432/SUBSTITUIR_BANCO
BACKUP_DIRECTORY=/var/lib/salao-backup
POSTGRES_BIN=/usr/lib/postgresql/17/bin

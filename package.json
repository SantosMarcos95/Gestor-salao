{
  "name": "salao-gestao",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run build -w @salao/api && concurrently -k -n api,web \"npm run dev -w @salao/api\" \"npm run dev -w @salao/web\"",
    "build": "npm run build -w @salao/api && npm run build -w @salao/web",
    "vercel-build": "prisma generate && npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx database/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:local": "node scripts/local-db.mjs",
    "test:integration": "npm run build && node tests/integration.mjs",
    "test:e2e": "npm run build && BROWSER_TEST=1 node tests/integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:backup": "node scripts/backup.mjs create",
    "db:restore": "node scripts/backup.mjs restore",
    "test:backup": "npm run build && BACKUP_TEST=1 node tests/integration.mjs",
    "test:recovery": "npm run build && BACKUP_TEST=1 RECOVERY_BROWSER_TEST=1 node tests/integration.mjs",
    "backup:run": "node scripts/backup-job.mjs run",
    "backup:check": "node scripts/backup-job.mjs check",
    "backup:decrypt": "node scripts/backup-job.mjs decrypt",
    "test:backup-job": "node --test tests/backup-job.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "pg": "^8.23.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
